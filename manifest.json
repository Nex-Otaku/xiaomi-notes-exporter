{
  "manifest_version": 3,
  "name": "Xiaomi Notes Export",
  "description": "Exporting notes from Xiaomi Cloud",
  "version": "1.0",
  "author": "Nex Otaku",
  "action": {
	"default_title": "Xiaomi Notes Export",
	"default_icon": "icons/icon128x128.png",
	"default_popup": "index.html"
  },
  "icons": {
	"16": "icons/icon16x16.png",
	"32": "icons/icon32x32.png",
	"48": "icons/icon48x48.png",
	"54": "icons/icon64x64.png",
	"96": "icons/icon96x96.png",
	"128": "icons/icon128x128.png"
  },
  "permissions": ["activeTab", "scripting"]
}